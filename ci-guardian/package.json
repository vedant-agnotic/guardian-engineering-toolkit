{
  "name": "@agnotic/ci-guardian",
  "version": "0.1.2",
  "description": "Run and maintain project quality checks (lint, tests, audit, Git Guardian rules) locally and in GitHub Actions with one required status. Config-driven CI runner with JSON reports.",
  "license": "MIT",
  "author": "Agnotic",
  "homepage": "https://github.com/vedant-agnotic/guardian-engineering-toolkit/tree/main/ci-guardian#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedant-agnotic/guardian-engineering-toolkit.git",
    "directory": "ci-guardian"
  },
  "bugs": {
    "url": "https://github.com/vedant-agnotic/guardian-engineering-toolkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "ci-guardian": "dist/cli.js"
  },
  "files": [
    "dist",
    "Readme.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepublishOnly": "npm test",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.js",
    "check": "npm test",
    "pack:local": "npm pack",
    "docs:check": "python3 scripts/check_docs.py"
  },
  "keywords": [
    "ci",
    "github-actions",
    "ci-cd",
    "quality-checks",
    "lint",
    "pull-request",
    "required-status",
    "husky-alternative",
    "git-hooks",
    "commit-message",
    "developer-tools",
    "guardrails",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
