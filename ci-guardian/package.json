{
  "name": "ci-guardian",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Repeatable quality checks for project-owned commands: validate, doctor and a sequential runner with JSON reports",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "ci-guardian": "dist/cli.js"
  },
  "files": [
    "dist",
    "Readme.md",
    "docs",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.js",
    "check": "npm test",
    "pack:local": "npm pack",
    "docs:check": "python3 scripts/check_docs.py"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
