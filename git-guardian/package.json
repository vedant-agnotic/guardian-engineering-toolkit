{
  "name": "@agnotic/git-guardian",
  "version": "0.1.1",
  "description": "Project-local Git policy enforcement for branch names and commit messages.",
  "type": "module",
  "author": "Agnotic",
  "homepage": "https://github.com/vedant-agnotic/guardian-engineering-toolkit/tree/main/git-guardian#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedant-agnotic/guardian-engineering-toolkit.git",
    "directory": "git-guardian"
  },
  "bugs": {
    "url": "https://github.com/vedant-agnotic/guardian-engineering-toolkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "git-guardian": "dist/cli.js"
  },
  "files": [
    "dist",
    "Readme.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "scripts": {
    "prepublishOnly": "npm test",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "check": "npm test",
    "pack:local": "npm pack",
    "docs:check": "python3 scripts/check_docs.py",
    "verify:release": "npm run build && node scripts/verify-release.mjs"
  },
  "engines": {
    "node": ">=20",
    "git": ">=2.28"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "git",
    "hooks",
    "branch-naming",
    "commit-message",
    "conventional-commits",
    "developer-tools",
    "guardrails",
    "cli"
  ],
  "license": "MIT"
}